# MongoDB connection — paste your Atlas connection string here
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# Database name (any name, will be created automatically)
DB_NAME=json_diff

# Public URL of the deployed backend (set on Render dashboard, used to build share links)
REACT_APP_BACKEND_URL=http://localhost:8001
